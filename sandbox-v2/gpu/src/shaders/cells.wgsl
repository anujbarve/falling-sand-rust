// Shared prelude of the thermal, fire and lava shaders (see pass_cells.rs).
// Concatenated after the header generated by reference_thermal::wgsl_header
// and after common.wgsl.
struct Params {
    w: u32,
    h: u32,
    tick: u32,
    seed: u32,
    phase: u32,
    pad0: u32,
    pad1: u32,
    pad2: u32,
}

@group(0) @binding(0) var<uniform> params: Params;
@group(0) @binding(1) var<storage, read> src: array<Cell>;
@group(0) @binding(2) var<storage, read_write> dst: array<Cell>;
// Sound event counters, indexed as state.rs EventKind
// (0 flow, 1 impact, 2 crackle, 3 boom).
@group(0) @binding(4) var<storage, read_write> events: array<atomic<u32>, 4>;

// Bit-pattern finiteness test (not x != x, which fast-math may fold).
fn finite(v: f32) -> bool { return (bitcast<u32>(v) & 0x7f800000u) != 0x7f800000u; }

// Table index of a material id; unknown ids act as WALL.
fn tid(m: u32) -> u32 { return min(m, WALL); }

fn inside(x: i32, y: i32) -> bool {
    return x >= 0 && y >= 0 && x < i32(params.w) && y < i32(params.h);
}

fn lin(x: i32, y: i32) -> u32 { return u32(y) * params.w + u32(x); }
