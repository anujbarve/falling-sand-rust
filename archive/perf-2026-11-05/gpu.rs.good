//! The GPU backend: the world lives in GPU buffers and each step is one
//! fused compute dispatch (heat and move together, see sim.wgsl). The CPU
//! only records commands; it never touches the cells until you read back.
//!
//! Chunk sleeping (rule and proof in mod.rs): threads whose cells are all in
//! sleeping 32x32 chunks return at once. A second tiny pass, `wake`, turns
//! the per-chunk activity stamps into next step's awake flags. Results are
//! bit-identical to not sleeping.

use super::{chunk_dims, World, CHUNK};
use std::num::NonZeroU64;
use std::sync::Arc;
use std::sync::atomic::{AtomicBool, AtomicU8, Ordering};

/// Steps that can be recorded into one submission. Each step needs its own
/// copy of the parameters (its frame number) in the uniform buffer.
const MAX_BATCH: u32 = 256;
/// Uniform buffer offsets must be multiples of this (WebGPU's default limit).
const PARAMS_STRIDE: u64 = 256;
/// One extra Params slot, after the batch slots, for the wake pass that
/// applies a changed visible mask before a step (see `apply_mask`).
const MASK_SLOT: u64 = MAX_BATCH as u64;
/// The shader is split by system (see physics/wgsl/) and joined here: WGSL
/// allows module-level declarations in any order.
const SHADER: &str = concat!(
    include_str!("wgsl/common.wgsl"),
    include_str!("wgsl/thermal.wgsl"),
    include_str!("wgsl/motion.wgsl"),
    include_str!("wgsl/step.wgsl"),
    include_str!("wgsl/wake.wgsl"),
    include_str!("wgsl/readback.wgsl"),
);
const WAKE_WORKGROUP: u32 = 8; // must match @workgroup_size of `wake`

/// Workgroup shape (threads) declared in sim.wgsl as `const GROUP_W: u32 = ..u;`.
/// Each thread owns a 2x2 block, so a workgroup covers 2*W x 2*H cells.
fn shader_const(name: &str) -> u32 {
    let prefix = format!("const {name}: u32 = ");
    SHADER
        .lines()
        .find_map(|l| l.strip_prefix(&prefix))
        .and_then(|rest| rest.trim_end_matches(';').trim_end_matches('u').parse().ok())
        .unwrap_or_else(|| panic!("sim.wgsl must declare {prefix}<n>u;"))
}

#[repr(C)]
#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
struct Params {
    width: u32,
    height: u32,
    frame: u32,
    /// Time-slice period (0 = off); must match common.wgsl.
    slice: u32,
}

pub struct GpuSim {
    device: wgpu::Device,
    queue: wgpu::Queue,
    step: wgpu::ComputePipeline,
    tile: (u32, u32), // cells covered by one workgroup of `step`
    wake: wgpu::ComputePipeline,
    params: wgpu::Buffer,
    // Two copies of the grid. The heat pass reads one and writes the other.
    cells: [wgpu::Buffer; 2],
    // groups[i] reads buffers i and writes buffers 1 - i.
    groups: [wgpu::BindGroup; 2],
    // CPU-readable buffer that results are copied into for `download`.
    staging: wgpu::Buffer,
    // Chunk sleeping, one u32 per chunk: the last frame in which the chunk
    // was active, and whether it runs in the next step. Plus a readback
    // buffer for `awake_chunks`.
    active: wgpu::Buffer,
    awake: wgpu::Buffer,
    awake_staging: wgpu::Buffer,
    // Visible-chunk mask (see `set_visible`): per chunk, 1 = frozen. The
    // CPU copy `frozen` is what the buffer holds (true = frozen).
    frozen_buf: wgpu::Buffer,
    frozen: Vec<bool>,
    /// The mask changed since the last step: the awake flags must be redone.
    mask_dirty: bool,
    /// Some chunk froze: copy its state into both grids before the next step.
    sync_pending: bool,
    sync: wgpu::ComputePipeline,
    /// Time-slice period (0 = off). See `set_slice`.
    slice: u32,
    chunks: (u32, u32),
    sleeping: bool,
    current: usize, // which of the two copies holds the latest state
    width: u32,
    height: u32,
    frame: u32,
    pub adapter_name: String,
    // --- pipelined readback (see `step_and_readback` / `latest`) ---
    readbacks: Vec<Readback>,
    /// Packs a rectangle of cells into a staging buffer (partial readbacks).
    packer: Packer,
    /// Bumped by `upload`: readbacks from an older epoch are thrown away.
    epoch: u64,
    readback_seq: u64,
    delivered_any: bool,
    // --- GPU timestamp queries (None when the adapter cannot do them) ---
    timer: Option<GpuTimer>,
}

impl GpuSim {
    /// Pick a GPU, compile the shader and upload `world`.
    /// Fails (instead of panicking) when the machine has no usable GPU.
    pub fn new(world: &World) -> Result<Self, String> {
        pollster::block_on(Self::new_async(world))
    }

    async fn new_async(world: &World) -> Result<Self, String> {
        let instance = wgpu::Instance::new(wgpu::InstanceDescriptor::new_without_display_handle());
        let adapter = instance
            .request_adapter(&wgpu::RequestAdapterOptions {
                power_preference: wgpu::PowerPreference::HighPerformance,
                ..Default::default()
            })
            .await
            .map_err(|e| e.to_string())?;
        let adapter_name = format!("{} ({:?})", adapter.get_info().name, adapter.get_info().backend);
        // Timestamps at the start/end of a pass, if the adapter has them.
        let timestamps = adapter.features().contains(wgpu::Features::TIMESTAMP_QUERY);
        // Ask for the adapter's own limits, so big grids (4K) fit in one buffer.
        let (device, queue) = adapter
            .request_device(&wgpu::DeviceDescriptor {
                label: Some("sand"),
                required_limits: adapter.limits(),
                required_features: if timestamps { wgpu::Features::TIMESTAMP_QUERY } else { wgpu::Features::empty() },
                ..Default::default()
            })
            .await
            .map_err(|e| e.to_string())?;

        let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
            label: Some("physics.wgsl"),
            source: wgpu::ShaderSource::Wgsl(SHADER.into()),
        });

        let storage = |binding: u32, read_only: bool| wgpu::BindGroupLayoutEntry {
            binding,
            visibility: wgpu::ShaderStages::COMPUTE,
            ty: wgpu::BindingType::Buffer {
                ty: wgpu::BufferBindingType::Storage { read_only },
                has_dynamic_offset: false,
                min_binding_size: None,
            },
            count: None,
        };
        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
            label: Some("sim"),
            entries: &[
                wgpu::BindGroupLayoutEntry {
                    binding: 0,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Uniform,
                        // The offset is chosen per dispatch: one Params per step.
                        has_dynamic_offset: true,
                        min_binding_size: NonZeroU64::new(size_of::<Params>() as u64),
                    },
                    count: None,
                },
                storage(1, true),
                storage(2, false),
                storage(3, false),
                storage(4, false),
                storage(5, true), // frozen (visible-chunk mask), read by wake and sync_frozen
            ],
        });
        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
            label: Some("sim"),
            bind_group_layouts: &[Some(&layout)],
            immediate_size: 0,
        });
        let pipeline = |entry: &str| {
            device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
                label: Some(entry),
                layout: Some(&pipeline_layout),
                module: &shader,
                entry_point: Some(entry),
                compilation_options: Default::default(),
                cache: None,
            })
        };
        let step = pipeline("step");
        let tile = (2 * shader_const("GROUP_W"), 2 * shader_const("GROUP_H"));
        let wake = pipeline("wake");
        let sync = pipeline("sync_frozen");

        let cell_count = (world.width * world.height) as u64;
        let buffer = |label: &str, usage: wgpu::BufferUsages| {
            device.create_buffer(&wgpu::BufferDescriptor {
                label: Some(label),
                size: cell_count * 4,
                usage,
                mapped_at_creation: false,
            })
        };
        let grid_usage = wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::COPY_SRC;
        let cells = [buffer("cells0", grid_usage), buffer("cells1", grid_usage)];
        let staging = buffer("staging", wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST);
        let (cw, ch) = chunk_dims(world.width, world.height);
        let chunk_buffer = |label: &str, usage: wgpu::BufferUsages| {
            device.create_buffer(&wgpu::BufferDescriptor {
                label: Some(label),
                size: (cw * ch * 4) as u64,
                usage,
                mapped_at_creation: false,
            })
        };
        let active = chunk_buffer("active", wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST);
        let awake = chunk_buffer("awake", grid_usage);
        let awake_staging = chunk_buffer("awake staging", wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST);
        let frozen_buf = chunk_buffer("frozen", wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST);
        let params = device.create_buffer(&wgpu::BufferDescriptor {
            label: Some("params"),
            size: (MAX_BATCH as u64 + 1) * PARAMS_STRIDE,
            usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
            mapped_at_creation: false,
        });

        let group = |src: usize| {
            let dst = 1 - src;
            device.create_bind_group(&wgpu::BindGroupDescriptor {
                label: Some("sim"),
                layout: &layout,
                entries: &[
                    wgpu::BindGroupEntry {
                        binding: 0,
                        resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
                            buffer: &params,
                            offset: 0,
                            size: NonZeroU64::new(size_of::<Params>() as u64),
                        }),
                    },
                    wgpu::BindGroupEntry { binding: 1, resource: cells[src].as_entire_binding() },
                    wgpu::BindGroupEntry { binding: 2, resource: cells[dst].as_entire_binding() },
                    wgpu::BindGroupEntry { binding: 3, resource: active.as_entire_binding() },
                    wgpu::BindGroupEntry { binding: 4, resource: awake.as_entire_binding() },
                    wgpu::BindGroupEntry { binding: 5, resource: frozen_buf.as_entire_binding() },
                ],
            })
        };
        let groups = [group(0), group(1)];
        let packer = Packer::new(&device, &shader, &cells, cell_count);
        let readbacks = (0..READBACK_SLOTS).map(|_| Readback::new(&device, cell_count * 4)).collect();
        let timer = timestamps.then(|| GpuTimer::new(&device, &queue));

        let mut sim = GpuSim {
            device,
            queue,
            step,
            tile,
            wake,
            params,
            cells,
            groups,
            staging,
            active,
            awake,
            awake_staging,
            frozen_buf,
            frozen: vec![false; cw * ch],
            mask_dirty: false,
            sync_pending: false,
            sync,
            slice: 0,
            chunks: (cw as u32, ch as u32),
            sleeping: true,
            current: 0,
            width: world.width as u32,
            height: world.height as u32,
            frame: world.frame,
            adapter_name,
            readbacks,
            packer,
            epoch: 0,
            readback_seq: 0,
            delivered_any: false,
            timer,
        };
        sim.upload(world);
        Ok(sim)
    }

    /// Replace the GPU's copy of the world (after painting on the CPU side).
    /// Wakes every chunk: the GPU does not know what changed. The visible
    /// mask goes back to all true, so the new world is computed everywhere.
    /// CONTRACT: the mask is cleared here. Call `set_visible` again after
    /// `upload` if an approximate view is wanted (it is not reapplied).
    pub fn upload(&mut self, world: &World) {
        assert_eq!((world.width as u32, world.height as u32), (self.width, self.height));
        self.queue.write_buffer(&self.cells[self.current], 0, bytemuck::cast_slice(&world.cells));
        self.frame = world.frame;
        // Readbacks already in flight hold the old world: never show them.
        self.epoch += 1;
        self.clear_mask();
        self.wake_all();
    }

    /// Every chunk computed again (the mask is all true).
    fn clear_mask(&mut self) {
        self.frozen.fill(false);
        let zeros = vec![0u32; self.frozen.len()];
        self.queue.write_buffer(&self.frozen_buf, 0, bytemuck::cast_slice(&zeros));
        self.mask_dirty = false;
        self.sync_pending = false;
    }

    /// Pretend every chunk was active in the step before the next one, so
    /// all chunks run for the next two steps and both buffers get rewritten.
    /// Frozen chunks stay asleep.
    fn wake_all(&self) {
        let n = (self.chunks.0 * self.chunks.1) as usize;
        let stamps = vec![self.frame.wrapping_sub(1); n];
        self.queue.write_buffer(&self.active, 0, bytemuck::cast_slice(&stamps));
        let awake: Vec<u32> = self.frozen.iter().map(|&f| u32::from(!f)).collect();
        self.queue.write_buffer(&self.awake, 0, bytemuck::cast_slice(&awake));
    }

    /// Set the visible-chunk mask: `mask[c]` true means chunk `c` is computed,
    /// false means it is frozen (approximate; see schedule.rs). One entry per
    /// chunk. It takes effect before the next `step`, or `step(0)`. A chunk
    /// that becomes visible again is marked active in the last step, so it
    /// and its neighbours run for the next two steps. Needs sleeping on for
    /// the wake rule to match `CpuSim::set_visible`.
    pub fn set_visible(&mut self, mask: &[bool]) {
        let n = self.chunk_count();
        assert_eq!(mask.len(), n, "one flag per chunk");
        let frozen: Vec<bool> = mask.iter().map(|&v| !v).collect();
        if frozen == self.frozen {
            return;
        }
        let stamp = self.frame.wrapping_sub(1);
        for c in 0..n {
            if frozen[c] && !self.frozen[c] {
                self.sync_pending = true;
            }
            if !frozen[c] && self.frozen[c] {
                let at = (4 * c) as u64;
                self.queue.write_buffer(&self.active, at, bytemuck::bytes_of(&stamp));
            }
        }
        let words: Vec<u32> = frozen.iter().map(|&f| u32::from(f)).collect();
        self.queue.write_buffer(&self.frozen_buf, 0, bytemuck::cast_slice(&words));
        self.frozen = frozen;
        self.mask_dirty = true;
    }

    /// Make a changed mask take effect before the next step. A frozen chunk
    /// that just froze has its state copied into both grids (`sync_frozen`).
    /// The awake flags of the next step are then recomputed by the wake rule,
    /// with the step before the next one as the "last" step (or, without
    /// sleeping, every unfrozen chunk is awake).
    fn apply_mask(&mut self) {
        let mut encoder = self.device.create_command_encoder(&Default::default());
        let offset = [(MASK_SLOT * PARAMS_STRIDE) as u32];
        let p = Params { width: self.width, height: self.height, frame: self.frame.wrapping_sub(1), slice: self.slice };
        self.queue.write_buffer(&self.params, MASK_SLOT * PARAMS_STRIDE, bytemuck::bytes_of(&p));
        // With time slicing, `step` copies the blocked chunks before every step,
        // so the mask-change sync is not needed here.
        if std::mem::take(&mut self.sync_pending) && self.slice == 0 {
            let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
                label: Some("sync frozen"),
                timestamp_writes: None,
            });
            pass.set_pipeline(&self.sync);
            pass.set_bind_group(0, &self.groups[self.current], &offset);
            pass.dispatch_workgroups(self.width.div_ceil(WAKE_WORKGROUP), self.height.div_ceil(WAKE_WORKGROUP), 1);
        }
        if self.wakes() {
            let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
                label: Some("wake (mask)"),
                timestamp_writes: None,
            });
            pass.set_pipeline(&self.wake);
            pass.set_bind_group(0, &self.groups[self.current], &offset);
            pass.dispatch_workgroups(self.chunks.0.div_ceil(WAKE_WORKGROUP), self.chunks.1.div_ceil(WAKE_WORKGROUP), 1);
        } else {
            self.wake_all();
        }
        self.queue.submit([encoder.finish()]);
        self.mask_dirty = false;
    }

    /// Turn chunk sleeping on (the default) or off. Off runs every chunk
    /// every step; only for measuring what sleeping saves. Same results.
    pub fn set_sleeping(&mut self, on: bool) {
        self.sleeping = on;
        self.wake_all();
    }

    /// Time slicing (approximate, opt-in; see `slice_mask` in schedule.rs):
    /// with `k > 0`, a chunk outside the visible mask runs in the steps where
    /// `(frame + c) % k == 0`, instead of never. `0` (the default) is off.
    /// Takes effect before the next step. Slicing always runs the sleeping
    /// rule (the wake pass), as `CpuSim::set_slice` does, even with sleeping
    /// off. Mass is conserved; heat is not.
    pub fn set_slice(&mut self, k: u32) {
        if k != self.slice {
            self.slice = k;
            self.mask_dirty = true;
        }
    }

    /// Does the wake pass run after each step (per-step awake flags)?
    fn wakes(&self) -> bool {
        self.sleeping || self.slice > 0
    }

    /// Total number of 32x32 chunks.
    pub fn chunk_count(&self) -> usize {
        (self.chunks.0 * self.chunks.1) as usize
    }

    /// How many chunks will run in the next step. Waits for queued work and
    /// reads the flags back, so it is slow: for benchmarks and tests.
    pub fn awake_chunks(&self) -> usize {
        let mut encoder = self.device.create_command_encoder(&Default::default());
        encoder.copy_buffer_to_buffer(&self.awake, 0, &self.awake_staging, 0, self.awake_staging.size());
        self.queue.submit([encoder.finish()]);
        self.awake_staging.map_async(wgpu::MapMode::Read, .., |r| r.expect("map failed"));
        self.wait();
        let count = {
            let view = self.awake_staging.get_mapped_range(..).expect("mapped");
            bytemuck::cast_slice::<u8, u32>(&view).iter().filter(|&&a| a != 0).count()
        };
        self.awake_staging.unmap();
        count
    }

    /// Queue `steps` simulation steps. Returns straight away: the GPU works
    /// in the background. Call `wait` or `download` to wait for it.
    pub fn step(&mut self, mut steps: u32) {
        if self.mask_dirty {
            self.apply_mask();
        }
        let total = steps;
        // Every step is one step pass, plus one wake pass when it wakes.
        let passes = total * if self.wakes() { 2 } else { 1 };
        // With time slicing, the blocked chunks are copied into both grids
        // before each step (see `sync_frozen`); only if some chunk is blocked.
        let slicing_sync = self.slice > 0 && self.frozen.iter().any(|&f| f);
        let timing = self.timer_begin(total).map(|slot| TimedCall {
            slot,
            steps: total,
            passes,
            per_pass: passes <= MAX_TIMED_PASSES,
            sleeping: self.sleeping,
        });
        let mut pass_index = 0u32;
        while steps > 0 {
            let batch = steps.min(MAX_BATCH);
            steps -= batch;

            // All the frame numbers for this batch, one per 256-byte slot.
            let mut bytes = vec![0u8; (batch as u64 * PARAMS_STRIDE) as usize];
            for s in 0..batch {
                let p = Params { width: self.width, height: self.height, frame: self.frame.wrapping_add(s), slice: self.slice };
                let at = (s as u64 * PARAMS_STRIDE) as usize;
                bytes[at..at + size_of::<Params>()].copy_from_slice(bytemuck::bytes_of(&p));
            }
            self.queue.write_buffer(&self.params, 0, &bytes);

            let mut encoder = self.device.create_command_encoder(&Default::default());
            for s in 0..batch {
                let offset = [(s as u64 * PARAMS_STRIDE) as u32];
                let group = &self.groups[self.current];
                // When the block offset o is 1, threads start one cell before
                // the grid (see sim.wgsl), so one more cell must be covered.
                let o = self.frame.wrapping_add(s) & 1;
                let groups = ((self.width + o).div_ceil(self.tile.0), (self.height + o).div_ceil(self.tile.1));
                // Each dispatch gets its own compute pass, so each one can carry
                // its own timestamps (Apple GPUs cannot time inside a pass). Passes
                // in one encoder are ordered, so each sees the previous one's writes.
                if slicing_sync {
                    let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
                        label: Some("sync frozen (slice)"),
                        timestamp_writes: None,
                    });
                    pass.set_pipeline(&self.sync);
                    pass.set_bind_group(0, group, &offset);
                    pass.dispatch_workgroups(self.width.div_ceil(WAKE_WORKGROUP), self.height.div_ceil(WAKE_WORKGROUP), 1);
                }
                {
                    let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
                        label: Some("step"),
                        timestamp_writes: self.timestamp_writes(timing, pass_index),
                    });
                    pass.set_bind_group(0, group, &offset);
                    pass.set_pipeline(&self.step);
                    pass.dispatch_workgroups(groups.0, groups.1, 1);
                }
                pass_index += 1;
                if self.wakes() {
                    let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
                        label: Some("wake"),
                        timestamp_writes: self.timestamp_writes(timing, pass_index),
                    });
                    pass.set_bind_group(0, group, &offset);
                    pass.set_pipeline(&self.wake);
                    pass.dispatch_workgroups(
                        self.chunks.0.div_ceil(WAKE_WORKGROUP),
                        self.chunks.1.div_ceil(WAKE_WORKGROUP),
                        1,
                    );
                    pass_index += 1;
                }
                self.current = 1 - self.current; // the output is now the input
            }
            self.queue.submit([encoder.finish()]);
            self.frame = self.frame.wrapping_add(batch);
        }
        self.timer_end(timing);
    }

    /// Block until the GPU has finished all queued work.
    pub fn wait(&self) {
        self.device.poll(wgpu::PollType::wait_indefinitely()).expect("GPU poll failed");
    }

    /// Copy the GPU's world back into `world` (waits for queued steps first).
    pub fn download(&self, world: &mut World) {
        let mut encoder = self.device.create_command_encoder(&Default::default());
        encoder.copy_buffer_to_buffer(&self.cells[self.current], 0, &self.staging, 0, self.staging.size());
        self.queue.submit([encoder.finish()]);

        // Mapping is asynchronous: ask for it, then poll until it is done.
        self.staging.map_async(wgpu::MapMode::Read, .., |r| r.expect("map failed"));
        self.wait();
        {
            let view = self.staging.get_mapped_range(..).expect("mapped");
            world.cells.copy_from_slice(bytemuck::cast_slice(&view));
        } // the view must be dropped before unmapping
        self.staging.unmap();
        world.frame = self.frame;
    }
}

// ---------------------------------------------------------------------------
// Pipelined readback: draw without waiting for the GPU.
//
// `download` copies the grid into one staging buffer and then blocks until
// the GPU is done. `step_and_readback` instead queues the steps plus a copy
// into the next of a few staging buffers and asks for it to be mapped, then
// returns at once. `latest` polls (without waiting) and hands over the
// newest copy that has arrived. The picture is usually one frame behind.
// ---------------------------------------------------------------------------

/// Staging buffers in rotation. 3 = one being drawn from, one in flight,
/// one spare, so the CPU never has to wait for the GPU in steady state.
const READBACK_SLOTS: usize = 3;

// Life of a staging buffer (readback or timer), kept in an AtomicU8 so the
// map callback (which wgpu calls from inside `poll`) can update it.
const FREE: u8 = 0; // unmapped, not used by any queued command
const PENDING: u8 = 1; // copy queued, map requested, not ready yet
const READY: u8 = 2; // mapped: the CPU may read it
// Timestamps written and submitted; the work is not known to be finished yet.
const WRITTEN: u8 = 3;

fn map_read(buffer: &wgpu::Buffer, state: &Arc<AtomicU8>) {
    state.store(PENDING, Ordering::Release);
    let state = state.clone();
    buffer.map_async(wgpu::MapMode::Read, .., move |r| {
        state.store(if r.is_ok() { READY } else { FREE }, Ordering::Release);
    });
}

/// A rectangle of cells in grid coordinates: `(x0, y0, w, h)`.
pub type Rect = (u32, u32, u32, u32);

/// Uniform for `pack_rect` (wgsl/readback.wgsl). Eight u32s, 32 bytes.
#[repr(C)]
#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
struct PackRect {
    x0: u32,
    y0: u32,
    w: u32,
    h: u32,
    stride: u32,
    _pad: [u32; 3],
}

/// The rectangle packing pass and its buffers: the rectangle is packed into
/// `out` (linear, row by row) and then copied into a readback slot.
struct Packer {
    pipeline: wgpu::ComputePipeline,
    threads: u32, // threads per workgroup of `pack_rect`, read from the WGSL
    params: wgpu::Buffer,
    groups: [wgpu::BindGroup; 2], // groups[i] reads cells[i]
    out: wgpu::Buffer,
}

impl Packer {
    fn new(device: &wgpu::Device, shader: &wgpu::ShaderModule, cells: &[wgpu::Buffer; 2], cell_count: u64) -> Self {
        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
            label: Some("pack rect"),
            entries: &[
                wgpu::BindGroupLayoutEntry {
                    binding: 0,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Uniform,
                        has_dynamic_offset: false,
                        min_binding_size: NonZeroU64::new(size_of::<PackRect>() as u64),
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 1,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: true },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
                wgpu::BindGroupLayoutEntry {
                    binding: 2,
                    visibility: wgpu::ShaderStages::COMPUTE,
                    ty: wgpu::BindingType::Buffer {
                        ty: wgpu::BufferBindingType::Storage { read_only: false },
                        has_dynamic_offset: false,
                        min_binding_size: None,
                    },
                    count: None,
                },
            ],
        });
        // Group 0 belongs to the sim; the packing pass uses group 1 only.
        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
            label: Some("pack rect"),
            bind_group_layouts: &[None, Some(&layout)],
            immediate_size: 0,
        });
        let pipeline = device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
            label: Some("pack_rect"),
            layout: Some(&pipeline_layout),
            module: shader,
            entry_point: Some("pack_rect"),
            compilation_options: Default::default(),
            cache: None,
        });
        let params = device.create_buffer(&wgpu::BufferDescriptor {
            label: Some("pack params"),
            size: size_of::<PackRect>() as u64,
            usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
            mapped_at_creation: false,
        });
        let out = device.create_buffer(&wgpu::BufferDescriptor {
            label: Some("packed"),
            size: cell_count * 4,
            usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
            mapped_at_creation: false,
        });
        let group = |src: &wgpu::Buffer| {
            device.create_bind_group(&wgpu::BindGroupDescriptor {
                label: Some("pack rect"),
                layout: &layout,
                entries: &[
                    wgpu::BindGroupEntry { binding: 0, resource: params.as_entire_binding() },
                    wgpu::BindGroupEntry { binding: 1, resource: src.as_entire_binding() },
                    wgpu::BindGroupEntry { binding: 2, resource: out.as_entire_binding() },
                ],
            })
        };
        let groups = [group(&cells[0]), group(&cells[1])];
        Packer { pipeline, threads: shader_const("PACK_WORKGROUP"), params, groups, out }
    }
}

struct Readback {
    buffer: wgpu::Buffer,
    state: Arc<AtomicU8>,
    frame: u32,                                // world.frame of the copied grid
    rect: Rect,                                // which cells the buffer holds, row by row
    epoch: u64,                                // GpuSim::epoch when it was queued
    seq: u64,                                  // queue order, to find the newest
    submission: Option<wgpu::SubmissionIndex>, // to wait for it if we must
}

impl Readback {
    fn new(device: &wgpu::Device, size: u64) -> Self {
        Readback {
            buffer: device.create_buffer(&wgpu::BufferDescriptor {
                label: Some("readback"),
                size,
                usage: wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST,
                mapped_at_creation: false,
            }),
            state: Arc::new(AtomicU8::new(FREE)),
            frame: 0,
            rect: (0, 0, 0, 0),
            epoch: 0,
            seq: 0,
            submission: None,
        }
    }

    fn state(&self) -> u8 {
        self.state.load(Ordering::Acquire)
    }

    fn release(&mut self) {
        self.buffer.unmap();
        self.state.store(FREE, Ordering::Release);
    }
}

impl GpuSim {
    /// Queue `steps` steps plus a copy of the result into a staging buffer,
    /// and start mapping it. Does not wait for the GPU (unless it is already
    /// `READBACK_SLOTS` frames behind, to stop work piling up). Pick the
    /// result up later with `latest`. `steps` may be 0 (just show paint).
    pub fn step_and_readback(&mut self, steps: u32) {
        self.step_and_readback_rect(steps, (0, 0, self.width, self.height));
    }

    /// Like `step_and_readback`, but copies only `rect` (`(x0, y0, w, h)` in
    /// cells). The world that `latest` fills in is still full size: only
    /// the cells inside `rect` are updated. A rectangle smaller than the
    /// grid is packed into a linear buffer on the GPU first (one compute
    /// pass, no per-row copies), so the copy is `w * h` cells, not the grid.
    pub fn step_and_readback_rect(&mut self, steps: u32, rect: Rect) {
        let (x0, y0, w, h) = rect;
        assert!(w > 0 && h > 0 && x0 + w <= self.width && y0 + h <= self.height, "readback rectangle outside the grid");
        self.step(steps);
        let slot = self.claim_readback_slot();
        let full = rect == (0, 0, self.width, self.height);
        let bytes = (w * h) as u64 * 4;

        let mut encoder = self.device.create_command_encoder(&Default::default());
        let rb = &self.readbacks[slot];
        if full {
            encoder.copy_buffer_to_buffer(&self.cells[self.current], 0, &rb.buffer, 0, bytes);
        } else {
            let p = PackRect { x0, y0, w, h, stride: self.width, _pad: [0; 3] };
            self.queue.write_buffer(&self.packer.params, 0, bytemuck::bytes_of(&p));
            let n = (w * h).div_ceil(self.packer.threads);
            let (gx, gy) = (n.min(65_535), n.div_ceil(n.min(65_535)));
            {
                let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
                    label: Some("pack rect"),
                    timestamp_writes: None,
                });
                pass.set_pipeline(&self.packer.pipeline);
                pass.set_bind_group(1, &self.packer.groups[self.current], &[]);
                pass.dispatch_workgroups(gx, gy, 1);
            }
            encoder.copy_buffer_to_buffer(&self.packer.out, 0, &rb.buffer, 0, bytes);
        }
        let submission = self.queue.submit([encoder.finish()]);

        self.readback_seq += 1;
        let rb = &mut self.readbacks[slot];
        rb.frame = self.frame;
        rb.rect = rect;
        rb.epoch = self.epoch;
        rb.seq = self.readback_seq;
        rb.submission = Some(submission);
        map_read(&rb.buffer, &rb.state);
    }

    /// A staging buffer we may copy into now.
    fn claim_readback_slot(&mut self) -> usize {
        let _ = self.device.poll(wgpu::PollType::Poll);
        if let Some(i) = self.readbacks.iter().position(|r| r.state() == FREE) {
            return i;
        }
        let oldest = |rs: &[Readback], state: u8| (0..rs.len()).filter(|&i| rs[i].state() == state).min_by_key(|&i| rs[i].seq);
        // A copy that arrived but nobody picked up: the one we are about to queue is newer.
        if let Some(i) = oldest(&self.readbacks, READY) {
            self.readbacks[i].release();
            return i;
        }
        // All in flight: the GPU is far behind. Wait for the oldest copy.
        let i = oldest(&self.readbacks, PENDING).expect("readback slots are free, ready or pending");
        let submission = self.readbacks[i].submission.clone();
        self.device
            .poll(wgpu::PollType::Wait { submission_index: submission, timeout: None })
            .expect("GPU poll failed");
        if self.readbacks[i].state() == READY {
            self.readbacks[i].release();
        }
        i
    }

    /// Copy the newest readback that has arrived into `world` and return the
    /// rectangle it covers. Only that rectangle of `world` is written; the
    /// rest of `world` keeps whatever it had. Returns `None` (and leaves
    /// `world` alone) if nothing new has arrived. Never waits, except when
    /// no readback has ever arrived yet. Readbacks queued before the last
    /// `upload` are dropped, so they can never undo what was uploaded.
    pub fn latest(&mut self, world: &mut World) -> Option<Rect> {
        let _ = self.device.poll(wgpu::PollType::Poll);
        let epoch = self.epoch;
        let usable = |r: &Readback| r.epoch == epoch && r.state() == READY;
        if !self.delivered_any && !self.readbacks.iter().any(usable) {
            let newest = self.readbacks.iter().filter(|r| r.epoch == epoch && r.state() == PENDING).max_by_key(|r| r.seq);
            if let Some(r) = newest {
                let submission = r.submission.clone();
                self.device
                    .poll(wgpu::PollType::Wait { submission_index: submission, timeout: None })
                    .expect("GPU poll failed");
            }
        }

        let best = (0..self.readbacks.len()).filter(|&i| usable(&self.readbacks[i])).max_by_key(|&i| self.readbacks[i].seq);
        let shown = best.map(|i| self.readbacks[i].rect);
        if let Some(i) = best {
            let rb = &self.readbacks[i];
            let (x0, y0, w, h) = rb.rect;
            let full = (x0, y0, w, h) == (0, 0, self.width, self.height);
            {
                let view = rb.buffer.get_mapped_range(..(w * h) as u64 * 4).expect("mapped");
                let packed: &[u32] = bytemuck::cast_slice(&view);
                if full {
                    world.cells.copy_from_slice(packed);
                } else {
                    // Packed rows go back to their place in the full-size world.
                    for (row, src) in packed.chunks_exact(w as usize).enumerate() {
                        let at = (y0 as usize + row) * self.width as usize + x0 as usize;
                        world.cells[at..at + w as usize].copy_from_slice(src);
                    }
                }
            } // the view must be dropped before unmapping
            world.frame = rb.frame;
            self.delivered_any = true;
        }
        // Everything that has arrived is now either shown or out of date.
        let best_seq = best.map_or(0, |i| self.readbacks[i].seq);
        for rb in &mut self.readbacks {
            if rb.state() == READY && (rb.epoch != epoch || rb.seq <= best_seq) {
                rb.release();
            }
        }
        shown
    }

    /// Overwrite single cells on the GPU, e.g. paint: `(index, packed cell)`.
    /// Cheaper than `upload` and, unlike it, keeps readbacks in flight: the
    /// edit simply shows up in the next readback. Edits with consecutive
    /// indices are sent as one write.
    pub fn write_cells(&mut self, edits: &[(usize, u32)]) {
        let cells = &self.cells[self.current];
        let queue = &self.queue;
        let flush = |start: usize, run: &mut Vec<u32>| {
            if !run.is_empty() {
                queue.write_buffer(cells, start as u64 * 4, bytemuck::cast_slice(run));
                run.clear();
            }
        };
        let (mut run, mut run_start) = (Vec::new(), 0usize);
        for &(i, cell) in edits {
            assert!(i < (self.width * self.height) as usize, "cell index out of range");
            if run.is_empty() || i != run_start + run.len() {
                flush(run_start, &mut run);
                run_start = i;
            }
            run.push(cell);
        }
        flush(run_start, &mut run);
        // An edit in a frozen chunk is never recomputed, so the other grid
        // must get it too.
        let other = &self.cells[1 - self.current];
        for &(i, cell) in edits {
            let (x, y) = (i % self.width as usize, i / self.width as usize);
            let chunk = (y / CHUNK) * self.chunks.0 as usize + x / CHUNK;
            if self.frozen[chunk] {
                self.queue.write_buffer(other, i as u64 * 4, bytemuck::bytes_of(&cell));
            }
        }
        // Edited chunks may be asleep, and only the current buffer got the
        // edit: wake everything so both buffers are rewritten.
        if !edits.is_empty() {
            self.wake_all();
        }
    }
}

// ---------------------------------------------------------------------------
// GPU timestamps: how long the GPU itself spent on the steps.
//
// Wall-clock time around `step` + `wait` also counts the CPU recording and
// submitting commands and the round trip to wake us up. With
// `Features::TIMESTAMP_QUERY` the GPU writes a tick count when a compute pass
// begins and when it ends. Each dispatch of a `step` call is its own pass, so
// the step and wake passes can be timed separately. We resolve the ticks into
// a buffer, read it back without waiting (like the readback above) and turn
// ticks into ms with `queue.get_timestamp_period()`.
//
// Query layout for one timed call with n passes:
// - query 0: the start of the first pass;
// - queries 2+2i and 3+2i: begin and end of pass i (see `pass_queries`).
//   Without per-pass timing (too many passes), query 1 holds the end of the
//   last pass instead. Either way the call's end is the last pass's end, so
//   `gpu_time_ms` reports the whole call (see `harvest`).
// ---------------------------------------------------------------------------

const TIMER_SLOTS: usize = 4;
/// wgpu allows at most 4096 queries in a set.
const TIMER_QUERIES: u32 = 4096;
/// Passes per timed call that get their own timestamps. A call with more
/// passes still reports the whole-call time, but no per-pass times.
const MAX_TIMED_PASSES: u32 = (TIMER_QUERIES - 2) / 2;

/// The query indices pass `i` of `n` writes: (begin, end), each optional.
/// The first pass begins at query 0, which is the call's own start.
fn pass_queries(i: u32, n: u32, per_pass: bool) -> (Option<u32>, Option<u32>) {
    let begin = if i == 0 { Some(0) } else if per_pass { Some(2 + 2 * i) } else { None };
    let end = if per_pass { Some(3 + 2 * i) } else if i + 1 == n { Some(1) } else { None };
    (begin, end)
}

/// A `step` call that is being timed.
#[derive(Clone, Copy)]
struct TimedCall {
    slot: usize,
    steps: u32,
    passes: u32,
    per_pass: bool,
    sleeping: bool,
}

/// Per-step GPU time of each kind of pass, in ms. Latest timed call that
/// has come back. Returned by `GpuSim::pass_times_ms`.
#[derive(Clone, Copy, Debug, PartialEq)]
pub struct PassTimes {
    pub step_ms: f64,
    pub wake_ms: f64,
}

struct TimerSlot {
    // Each slot has its own query set. A shared one could be overwritten by a
    // later call before this call's timestamps are resolved.
    queries: wgpu::QuerySet,
    resolve: wgpu::Buffer,
    buffer: wgpu::Buffer,
    state: Arc<AtomicU8>,
    // Set by the queue when all work submitted before `timer_end` has finished.
    done: Arc<AtomicBool>,
    call: Option<TimedCall>,
    seq: u64,
}

struct GpuTimer {
    slots: Vec<TimerSlot>,
    ns_per_tick: f64,
    seq: u64,
    last_seq: u64,
    last_ms_per_step: Option<f64>,
    last_pass_seq: u64,
    last_pass: Option<PassTimes>,
}

impl GpuTimer {
    fn new(device: &wgpu::Device, queue: &wgpu::Queue) -> Self {
        let size = TIMER_QUERIES as u64 * wgpu::QUERY_SIZE as u64;
        let buffer = |label: &str, usage: wgpu::BufferUsages| {
            device.create_buffer(&wgpu::BufferDescriptor { label: Some(label), size, usage, mapped_at_creation: false })
        };
        GpuTimer {
            slots: (0..TIMER_SLOTS)
                .map(|_| TimerSlot {
                    queries: device.create_query_set(&wgpu::QuerySetDescriptor {
                        label: Some("step timestamps"),
                        ty: wgpu::QueryType::Timestamp,
                        count: TIMER_QUERIES,
                    }),
                    resolve: buffer("timestamps resolve", wgpu::BufferUsages::QUERY_RESOLVE | wgpu::BufferUsages::COPY_SRC),
                    buffer: buffer("timestamps readback", wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST),
                    state: Arc::new(AtomicU8::new(FREE)),
                    done: Arc::new(AtomicBool::new(false)),
                    call: None,
                    seq: 0,
                })
                .collect(),
            ns_per_tick: queue.get_timestamp_period() as f64,
            seq: 0,
            last_seq: 0,
            last_ms_per_step: None,
            last_pass_seq: 0,
            last_pass: None,
        }
    }

    /// Resolve the timestamps of every call whose work has finished, and
    /// start reading them back. Resolving before the work has finished can
    /// read queries the GPU has not written yet (seen as missing or stale
    /// values for the last passes of a call), so this waits for the queue's
    /// "work done" signal. The copy itself is queued, never waited on.
    fn resolve_ready(&mut self, device: &wgpu::Device, queue: &wgpu::Queue) {
        for slot in &mut self.slots {
            if slot.state.load(Ordering::Acquire) != WRITTEN || !slot.done.load(Ordering::Acquire) {
                continue;
            }
            let Some(call) = slot.call else { continue };
            let count = if call.per_pass { 2 + 2 * call.passes } else { 2 };
            let mut encoder = device.create_command_encoder(&Default::default());
            encoder.resolve_query_set(&slot.queries, 0..count, &slot.resolve, 0);
            encoder.copy_buffer_to_buffer(&slot.resolve, 0, &slot.buffer, 0, count as u64 * wgpu::QUERY_SIZE as u64);
            queue.submit([encoder.finish()]);
            map_read(&slot.buffer, &slot.state);
        }
    }

    /// Read every timestamp that has arrived; keep the newest of each kind.
    fn harvest(&mut self) {
        for slot in &mut self.slots {
            if slot.state.load(Ordering::Acquire) != READY {
                continue;
            }
            let Some(call) = slot.call else { continue };
            // (whole-call span, per-kind tick sums or None when not timed per pass)
            let (span, sums): ((u64, u64), Option<[u64; 2]>) = {
                let view = slot.buffer.get_mapped_range(..).expect("mapped");
                let q = |i: u32| -> u64 { bytemuck::pod_read_unaligned(&view[i as usize * 8..][..8]) };
                // The call ends with its last pass.
                let last_end = if call.per_pass { 3 + 2 * (call.passes - 1) } else { 1 };
                let span = (q(0), q(last_end));
                let sums = call.per_pass.then(|| {
                    let mut sums = [0u64; 2]; // [step, wake]
                    for i in 0..call.passes {
                        let (Some(b), Some(e)) = pass_queries(i, call.passes, true) else { return None };
                        let ticks = q(e).checked_sub(q(b))?;
                        // Passes alternate step, wake when sleeping.
                        let kind = if call.sleeping { (i % 2) as usize } else { 0 };
                        sums[kind] += ticks;
                    }
                    Some(sums)
                });
                (span, sums.flatten())
            };
            slot.buffer.unmap();
            slot.state.store(FREE, Ordering::Release);
            if slot.seq > self.last_seq && span.1 > span.0 && call.steps > 0 {
                let ms = (span.1 - span.0) as f64 * self.ns_per_tick / 1e6;
                self.last_ms_per_step = Some(ms / call.steps as f64);
                self.last_seq = slot.seq;
            }
            if slot.seq > self.last_pass_seq && call.steps > 0 {
                if let Some(sums) = sums {
                    let per_step = |ticks: u64| ticks as f64 * self.ns_per_tick / 1e6 / call.steps as f64;
                    self.last_pass = Some(PassTimes { step_ms: per_step(sums[0]), wake_ms: per_step(sums[1]) });
                    self.last_pass_seq = slot.seq;
                }
            }
        }
    }
}

impl GpuSim {
    /// Does this GPU report timestamps? If not, `gpu_time_ms` is always None.
    pub fn has_timestamps(&self) -> bool {
        self.timer.is_some()
    }

    /// GPU time per step, in ms, of the most recent `step` call whose
    /// timestamps have come back. Measured on the GPU's own clock, so it
    /// leaves out CPU-side recording, submitting and waiting. Never blocks.
    pub fn gpu_time_ms(&mut self) -> Option<f64> {
        let _ = self.device.poll(wgpu::PollType::Poll);
        let timer = self.timer.as_mut()?;
        timer.resolve_ready(&self.device, &self.queue);
        timer.harvest();
        timer.last_ms_per_step
    }

    /// GPU time per step of the step pass and of the wake pass, in ms, from
    /// the most recent `step` call whose per-pass timestamps have come back.
    /// None without timestamp support, or for a call with too many passes
    /// (see `MAX_TIMED_PASSES`). Never blocks, like `gpu_time_ms`.
    pub fn pass_times_ms(&mut self) -> Option<PassTimes> {
        let _ = self.device.poll(wgpu::PollType::Poll);
        let timer = self.timer.as_mut()?;
        timer.resolve_ready(&self.device, &self.queue);
        timer.harvest();
        timer.last_pass
    }

    /// Start of `step`: pick a free timer slot, or None to not time this call
    /// (no timestamp support, nothing to run, or all slots still in flight).
    fn timer_begin(&mut self, steps: u32) -> Option<usize> {
        let timer = self.timer.as_mut()?;
        if steps == 0 {
            return None;
        }
        timer.resolve_ready(&self.device, &self.queue);
        timer.harvest();
        timer.slots.iter().position(|s| s.state.load(Ordering::Acquire) == FREE)
    }

    /// Timestamp writes for pass `pass` (0-based, counted over the whole
    /// timed call), or None when this pass is not timed.
    fn timestamp_writes(&self, timing: Option<TimedCall>, pass: u32) -> Option<wgpu::ComputePassTimestampWrites<'_>> {
        let call = timing?;
        let timer = self.timer.as_ref()?;
        let (begin, end) = pass_queries(pass, call.passes, call.per_pass);
        (begin.is_some() || end.is_some()).then(|| wgpu::ComputePassTimestampWrites {
            query_set: &timer.slots[call.slot].queries,
            beginning_of_pass_write_index: begin,
            end_of_pass_write_index: end,
        })
    }

    /// End of `step`: mark the call's timestamps as written. They are
    /// resolved once the queue reports that the work has finished.
    fn timer_end(&mut self, timing: Option<TimedCall>) {
        let (Some(call), Some(timer)) = (timing, self.timer.as_mut()) else { return };
        timer.seq += 1;
        let slot = &mut timer.slots[call.slot];
        slot.call = Some(call);
        slot.seq = timer.seq;
        slot.done.store(false, Ordering::Release);
        slot.state.store(WRITTEN, Ordering::Release);
        let done = slot.done.clone();
        // Runs after all work submitted so far (the passes of this call).
        self.queue.on_submitted_work_done(move || done.store(true, Ordering::Release));
    }
}
